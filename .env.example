# Copy to .env for local overrides. Never commit real tokens.

# --- GitHub Copilot SDK authentication -------------------------------------
# Local dev: leave the token empty and sign in once with the Copilot CLI (`copilot` -> /login)
# or `gh auth login`; the SDK reuses that identity.
# Containers/Azure: fine-grained PAT with the "Copilot Requests" permission.
COPILOT_GITHUB_TOKEN=
COPILOT_USE_LOGGED_IN_USER=true
# Optional model override, e.g. gpt-5-mini or claude-sonnet-4.5. Empty = SDK default.
COPILOT_MODEL=
AGENT_TIMEOUT_SECONDS=90

# --- Runtime metadata (set automatically by the deploy workflow) ------------
APP_VERSION=dev
PREVIEW_LABEL=

# --- Paths (defaults work for local dev and the container) ------------------
# SAMPLE_DATA_DIR=../sample-data
# STATIC_DIR=./static
